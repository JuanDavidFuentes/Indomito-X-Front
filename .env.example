# Indómito X — web. Copia este archivo a `.env` para desarrollo local.
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
# Bucket público de S3 (logos, portadas y fotos de perfil); en producción, el CDN
MEDIA_URL=http://localhost:9000/indomitox-public
# Enlaces que abren la app (EXP-04), opcionales:
# huellas SHA-256 de los certificados de firma de Android, separadas por comas (Play Console → Integridad de la app)
ANDROID_CERT_SHA256=
# Team ID de Apple (developer.apple.com → Membership) para los Universal Links de iOS
APPLE_TEAM_ID=
